generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Account {
  id                String  @id @default(cuid())
  userId            String  @map("user_id")
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model User {
  id            String    @id @default(cuid())
  username      String?   @unique
  password      String?
  createdAt     DateTime  @default(now()) @db.Timestamp(6)
  updatedAt     DateTime  @updatedAt
  name          String?
  email         String?   @unique
  emailVerified DateTime? @map("email_verified")
  image         String?
  accounts      Account[]
  sessions      Session[]
  @@map("users")
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime
  @@unique([identifier, token])
  @@map("verification_tokens")
}

enum Priority {
  Routine
  Urgent
  Stat
}

model File {
  id        String   @id @default(cuid())
  filename  String   
  path      String   
  caseId    String   
  case      Case     @relation(fields: [caseId], references: [id], onDelete: Cascade)
  uploadedAt DateTime @default(now())
  @@index([caseId])  
}

model Report {
  id         String   @id @default(cuid())
  filename   String   
  path       String   
  caseId     String   @unique
  case       Case     @relation(fields: [caseId], references: [id], onDelete: Cascade)
  uploadedAt DateTime @default(now())
  @@index([caseId])  
}

model Signature {
  id              String       @id @default(cuid())
  filename        String   
  path            String   
  svgPath         String
  radiologistId   String       @unique
  radiologist     Radiologist? @relation(fields: [radiologistId], references: [id], onDelete: Cascade)
  uploadedAt      DateTime     @default(now())
  @@index([radiologistId])  
}

model Study {
  id        String   @id @default(cuid())
  name      String   @unique
  studyView String[] @default([]) 
  studySide String[] @default([]) 
  studyType String[] @default([]) 
  cases     Case[]  // Many-to-many relationship without fields/references
}

model Case {
  id              String     @id @default(cuid())
  patientId       String     @unique
  doctor          String   
  priority        Priority  
  history         String  
  activeCase      Boolean    @default(false)
  completedCase   Boolean    @default(false)
  files           File[]     
  studies         Study[]    // Many-to-many relationship without fields/references
  report          Report?
  patientName     String
  studyDescription String
  gender          String
  modality        String
  series          String
  studyDate       String
  studyTime       String
  radiologist     String?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
}

model Hospital {
  id         String     @id @default(cuid()) 
  name       String  
  email      String     @unique 
  phone      String     @unique
  isDefault  Boolean    @default(false) 
  createdAt  DateTime   @default(now()) 
  updatedAt  DateTime   @updatedAt
}

model Radiologist {
  id                 String     @id @default(cuid()) 
  name               String  
  email              String     @unique 
  phone              String     @unique 
  qualifications     String
  designation        String
  mrn                String     @unique
  signature          Signature?
  isDefault          Boolean    @default(false) 
  createdAt          DateTime   @default(now()) 
  updatedAt          DateTime   @updatedAt
}