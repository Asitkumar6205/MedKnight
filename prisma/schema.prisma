generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Account {
  id                String  @id @default(cuid())
  userId            String  @map("user_id")
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model User {
  id            String    @id @default(cuid())
  username      String?   @unique
  password      String?
  createdAt     DateTime  @default(now()) @db.Timestamp(6)
  updatedAt     DateTime  @updatedAt
  name          String?
  email         String?   @unique
  emailVerified DateTime? @map("email_verified")
  image         String?
  accounts      Account[]
  sessions      Session[]

  @@map("users")
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime
  @@unique([identifier, token])
  @@map("verification_tokens")
}

model Active {
  id         String     @id @default(cuid())
  doctor     String   
  priority   Priority  
  history    String  
  files      File[]     
  studies    Study[]    // Many-to-many relationship without fields/references
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
}

model Study {
  id        String   @id @default(cuid())
  name      String   @unique
  studyView String[] @default([]) 
  studySide String[] @default([]) 
  studyType String[] @default([]) 
  actives   Active[]  // Many-to-many relationship without fields/references
}

model File {
  id        String   @id @default(cuid())
  filename  String   
  path      String   
  activeId  String   
  active    Active   @relation(fields: [activeId], references: [id], onDelete: Cascade)
  uploadedAt DateTime @default(now())
  @@index([activeId])  
}

enum Priority {
  Routine
  Urgent
  Stat
}

model Hospital {
  id         String     @id @default(cuid()) 
  name       String  
  email      String     @unique 
  phone      String  
  isDefault  Boolean    @default(false) 
  createdAt  DateTime   @default(now()) 
  updatedAt  DateTime   @updatedAt
}
