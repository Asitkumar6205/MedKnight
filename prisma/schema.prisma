generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Account {
  id                String  @id @default(cuid())
  userId            String  @map("user_id")
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model User {
  id            String    @id @default(cuid())
  username      String?   @unique
  password      String?
  createdAt     DateTime  @default(now()) @db.Timestamp(6)
  updatedAt     DateTime  @updatedAt
  name          String?
  email         String?   @unique
  emailVerified DateTime? @map("email_verified")
  image         String?
  role          Role      @default(PENDING)
  status        UserStatus @default(PENDING_APPROVAL)
  accounts      Account[]
  sessions      Session[]
  @@map("users")
}

enum Role {
  ADMIN
  RADIOLOGIST
  HOSPITAL
  PENDING
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  PENDING_APPROVAL
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime
  @@unique([identifier, token])
  @@map("verification_tokens")
}

enum Priority {
  Routine
  Urgent
  Stat
}

model File {
  id        String   @id @default(cuid())
  filename  String   
  path      String   
  caseId    String   
  case      Case     @relation(fields: [caseId], references: [id], onDelete: Cascade)
  uploadedAt DateTime @default(now())
  @@index([caseId])  
}

model Report {
  id         String   @id @default(cuid())
  filename   String   
  path       String   
  caseId     String   @unique
  case       Case     @relation(fields: [caseId], references: [id], onDelete: Cascade)
  uploadedAt DateTime @default(now())
  @@index([caseId])  
}

model Signature {
  id              String       @id @default(cuid())
  filename        String   
  path            String   
  svgPath         String
  radiologistId   String       @unique
  radiologist     Radiologist? @relation(fields: [radiologistId], references: [id], onDelete: Cascade)
  uploadedAt      DateTime     @default(now())
  @@index([radiologistId])  
}

model Study {
  id        String   @id @default(cuid())
  name      String   @unique
  studyView String[] @default([]) 
  studySide String[] @default([]) 
  studyType String[] @default([])
  price     Int? 
  cases     Case[]  // Many-to-many relationship without fields/references
}

model Case {
  id               String     @id @default(cuid())
  patientId        String     @unique
  doctor           String   
  doctorPhNo       String?    
  technicianName   String?
  reviewReason     String?
  priority         Priority  
  history          String  
  activeCase       Boolean    @default(false)
  completedCase    Boolean    @default(false)
  reviewCase       Boolean    @default(false)
  files            File[]     
  studies          Study[]    
  report           Report?
  patientName      String
  studyDescription String
  gender           String
  modality         String
  series           String
  studyDate        String
  studyTime        String
  reportTime       String?
  radiologist      String?
  priceItems       PriceItem[] // One-to-many relationship
  totalAmount      Int?        // Add total amount field
  paymentStatus    PaymentStatus @default(PENDING)
  billingMonth     String?    // Format: "YYYY-MM"
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
}

model PriceItem {
  id         String   @id @default(cuid())
  studyName  String   // The specific study (e.g., "CT Brain")
  cost       Int      // Cost of this specific study
  caseId     String   
  case       Case     @relation(fields: [caseId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
  @@index([caseId])  
}

enum PaymentStatus {
  PENDING
  PAID
  PARTIAL
  REFUNDED
  CANCELLED
}

// Optional: Monthly Bill model for aggregating cases
model MonthlyBill {
  id            String    @id @default(cuid())
  month         String    // Format: "YYYY-MM"
  totalAmount   Int
  paidAmount    Int       @default(0)
  paymentStatus PaymentStatus @default(PENDING)
  cases         String[]  // Array of case IDs included in this bill
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Hospital {
  id         String     @id @default(cuid()) 
  name       String  
  email      String     @unique 
  phone      String     @unique
  isDefault  Boolean    @default(false) 
  createdAt  DateTime   @default(now()) 
  updatedAt  DateTime   @updatedAt
}

model Radiologist {
  id                 String     @id @default(cuid()) 
  name               String  
  email              String     @unique 
  phone              String     @unique 
  qualifications     String
  designation        String
  mrn                String     @unique
  signature          Signature?
  isDefault          Boolean    @default(false) 
  createdAt          DateTime   @default(now()) 
  updatedAt          DateTime   @updatedAt
}